<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>栄冠ラグビー</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  background:#f4f6f8;
  color:#18202a;
  font-family:-apple-system,BlinkMacSystemFont,
  "Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;
}

header{
  background:#123b27;
  color:white;
  padding:18px 16px;
  position:sticky;
  top:0;
  z-index:10;
}

header h1{
  margin:0;
  font-size:24px;
}

header small{
  opacity:.8;
}

nav{
  display:flex;
  overflow:auto;
  background:white;
  border-bottom:1px solid #ddd;
  position:sticky;
  top:70px;
  z-index:9;
}

nav button{
  border:0;
  background:white;
  padding:13px 16px;
  white-space:nowrap;
  font-weight:bold;
  color:#52606d;
}

nav button.active{
  color:#146c43;
  border-bottom:3px solid #146c43;
}

main{
  max-width:900px;
  margin:auto;
  padding:14px;
}

.panel,
.card{
  background:white;
  border-radius:14px;
  padding:15px;
  margin-bottom:12px;
  box-shadow:0 2px 8px #0000000d;
}

.grid{
  display:grid;
  grid-template-columns:
  repeat(auto-fit,minmax(145px,1fr));
  gap:10px;
}

.stat{
  background:#f3f6f5;
  padding:10px;
  border-radius:10px;
}

.stat b{
  display:block;
  font-size:20px;
}

button.action{
  border:0;
  border-radius:10px;
  padding:11px 14px;
  background:#176b45;
  color:white;
  font-weight:bold;
  margin:4px 3px;
}

button.secondary{
  background:#e8eeeb;
  color:#173d2c;
}

.row{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
}

.muted{
  color:#6b7280;
  font-size:13px;
}

.tag{
  display:inline-block;
  background:#e6f2eb;
  color:#176b45;
  border-radius:999px;
  padding:3px 8px;
  font-size:12px;
  margin:2px;
}

.players{
  display:grid;
  gap:8px;
}

.playerLine{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12px;
  border:1px solid #e2e7e4;
  border-radius:10px;
}

.player{
  cursor:pointer;
}

.player:hover{
  background:#f2f7f4;
}

input[type=checkbox]{
  width:20px;
  height:20px;
}

.modal{
  position:fixed;
  inset:0;
  background:#0008;
  display:none;
  align-items:flex-end;
  justify-content:center;
  z-index:20;
}

.modal.open{
  display:flex;
}

.modalBox{
  background:white;
  width:min(900px,100%);
  max-height:88vh;
  overflow:auto;
  border-radius:18px 18px 0 0;
  padding:18px;
}

.close{
  float:right;
  border:0;
  background:#eee;
  border-radius:50%;
  width:36px;
  height:36px;
  font-size:20px;
}

h2{
  margin:8px 0 12px;
}

h3{
  margin:4px 0 8px;
}

table{
  width:100%;
  border-collapse:collapse;
  font-size:14px;
}

th,
td{
  padding:8px;
  border-bottom:1px solid #e5e7eb;
  text-align:left;
}

.facility{
  display:grid;
  grid-template-columns:1fr auto;
  gap:8px;
  align-items:center;
  padding:12px 0;
  border-bottom:1px solid #eee;
}

@media(max-width:600px){
  header{
    padding:14px;
  }

  .grid{
    grid-template-columns:repeat(2,1fr);
  }

  nav button{
    padding:12px 11px;
    font-size:13px;
  }
}
</style>
</head>

<body>

<header>
  <h1>🏉 栄冠ラグビー</h1>
  <small id="season"></small>
</header>

<nav id="nav"></nav>

<main id="app"></main>

<div id="modal" class="modal"
onclick="if(event.target===this)closeModal()">

  <div class="modalBox">

    <button class="close"
    onclick="closeModal()">×</button>

    <div id="modalBody"></div>

  </div>

</div>

<script>

const SCHOOL_DATA = [

["桐蔭学園","神奈川",86],
["東福岡","福岡",88],
["大阪桐蔭","大阪",84],
["國學院栃木","栃木",80],
["京都成章","京都",82],
["佐賀工業","佐賀",79],
["常翔学園","大阪",81],
["御所実業","奈良",80],
["流通経済大柏","千葉",82],
["報徳学園","兵庫",83]

];

const POS = [
"PR","HO","PR",
"LO","LO",
"FL","FL","No.8",
"SH","SO",
"WTB","CTB","CTB",
"WTB","FB"
];

const UNIVERSITIES = [

"早稲田大学",
"明治大学",
"帝京大学",
"京都産業大学",
"同志社大学",
"天理大学",
"関西学院大学",
"立命館大学",
"筑波大学",
"慶應義塾大学"

];

const FIRST = [

"佐藤","鈴木","田中","高橋","伊藤",
"渡辺","山本","中村","小林","加藤",
"吉田","山田","佐々木","山口","松本",
"井上","木村","林","清水","斎藤"

];

const GIVEN = [

"蓮","翔太","大輔","海斗","悠真",
"健太","颯","陽向","拓海","直樹",
"陸","蒼","優斗","湊","樹",
"駿","晴","大和","翼","涼"

];

const saveKey="eikan_rugby_save_v2";

let state=
JSON.parse(localStorage.getItem(saveKey)||"null");

if(!state){

 state={
  year:2026,
  month:4,
  school:"報徳学園",
  team:[],
  scouts:[],
  history:[],
  matches:[],
  graduates:[],
  legends:[],
  facilityPoints:100,

  facilities:{
   training:1,
   ground:1,
   medical:1,
   scout:1,
   coach:1,
   stadium:1
  },

  selected:[],
  active:"home",
  match:null
 };

 state.team=makeTeam(state.school);

 state.scouts=generateScouts(30);

 save();

}

function save(){

 localStorage.setItem(
  saveKey,
  JSON.stringify(state)
 );

}

function rand(a,b){

 return Math.floor(
  Math.random()*(b-a+1)
 )+a;

}

function avg(p){

 return Math.round(
  (
   p.power+
   p.speed+
   p.stamina+
   p.pass+
   p.kick+
   p.tackle+
   p.decision
  )/7
 );

}

function makeName(i=0){

 return FIRST[i%FIRST.length]
 +" "+
 GIVEN[
  (i*7+rand(0,19))
  %GIVEN.length
 ];

}

function player(
 n,
 pos,
 base,
 school
){

 let v=()=>Math.max(
  35,
  Math.min(
   99,
   base+rand(-7,8)
  )
 );

 let p={

  id:Date.now()+Math.random(),

  name:n,

  year:1,

  pos,

  school,

  fromSchool:school,

  power:v(),

  speed:v(),

  stamina:v(),

  pass:v(),

  kick:v(),

  tackle:v(),

  decision:v(),

  path:"未定",

  commitment:0

 };

 p.overall=avg(p);

 return p;

}

function makeTeam(school){

 let data=
 SCHOOL_DATA.find(
  x=>x[0]===school
 );

 let base=data?data[2]:80;

 return Array.from(
  {length:20},
  (_,i)=>
   player(
    makeName(i),
    POS[i%15],
    base,
    school
   )
 );

}

function generateScouts(count){

 return Array.from(
  {length:count},
  (_,i)=>{

   let s=
   SCHOOL_DATA[
    rand(0,SCHOOL_DATA.length-1)
   ];

   let p=
   player(
    makeName(i+30),
    POS[i%15],
    s[2]+rand(-4,8),
    s[0]
   );

   p.region=s[1];

   p.foreign=Math.random()<0.07;

   p.year=1;

   return p;

  }
 );

}

function ensureScouts(){

 if(!state.scouts.length){

  state.scouts=
  generateScouts(30);

 }

}

const tabs=[

 ["home","ホーム"],
 ["players","選手"],
 ["scout","スカウト"],
 ["school","学校"],
 ["records","記録"]

];

function renderNav(){

 document.getElementById("nav")
 .innerHTML=
 tabs.map(
  ([id,t])=>
  `<button
   class="${state.active===id?"active":""}"
   onclick="go('${id}')">
   ${t}
  </button>`
 ).join("");

}

function go(id){

 state.active=id;

 save();

 render();

}

function render(){

 renderNav();

 document.getElementById("season")
 .textContent=
 `${state.year}年度 ${state.month}月　
 ${state.school}　
 部員${state.team.length}人`;

 document.getElementById("app")
 .innerHTML=
 pages[state.active]();

}

const pages={

home:()=>`

<div class="panel">

<h2>🏉 ${state.school}</h2>

<p>
全国制覇を目指して
チームを育てよう。
</p>

<div class="grid">

<div class="stat">
<span>チーム平均</span>
<b>
${Math.round(
 state.team.reduce(
  (s,p)=>s+p.overall,0
 )/
 Math.max(1,state.team.length)
)}
</b>
</div>

<div class="stat">
<span>部員</span>
<b>
${state.team.length}/25
</b>
</div>

<div class="stat">
<span>施設ポイント</span>
<b>
${state.facilityPoints}
</b>
</div>

<div class="stat">
<span>年度</span>
<b>
${state.year}
</b>
</div>

</div>

</div>

<div class="panel">

<h3>今月の行動</h3>

<button class="action"
onclick="train()">
🏋️ 練習する
</button>

<button class="action"
onclick="openMatchSelect()">
🏉 練習試合
</button>

<button class="action"
onclick="nextMonth()">
📅 月を進める
</button>

<p class="muted">
練習で能力を伸ばし、
スカウトや施設強化で
戦力を整えよう。
</p>

</div>

<div class="panel">

<h3>チーム状況</h3>

${state.team
.slice(0,5)
.map(p=>miniPlayer(p))
.join("")}

</div>

`,

players:()=>`

<div class="panel">

<h2>👤 選手一覧</h2>

<p class="muted">
選手をタップすると
詳細ステータスを確認できます。
</p>

<div class="players">

${state.team
.map(p=>miniPlayer(p,true))
.join("")}

</div>

</div>

`,

scout:()=>{

 ensureScouts();

 return `

<div class="panel">

<div class="row">

<div>

<h2>🔎 スカウト候補30人</h2>

<p class="muted">
複数人を選択して獲得できます。
最大25人。
</p>

</div>

<button class="action"
onclick="refreshScouts()">
更新
</button>

</div>

<div class="players">

${state.scouts.map(
(p,i)=>

<label class="playerLine">

<span>

<input
 type="checkbox"
 ${state.selected.includes(p.id)?"checked":""}
 onchange="toggleScout('${p.id}')">

 <b>${p.name}</b>

 ${p.pos}

 <span class="tag">
 総合 ${p.overall}
 </span>

 <br>

 <span class="muted">
 ${p.fromSchool}・
 ${p.region}
 ${p.foreign?"・海外":""}
 </span>

</span>

<button class="action secondary"
onclick="showPlayer('${p.id}',true)">
詳細
</button>

</label>

).join("")}

</div>

<button class="action"
onclick="signSelected()">

選択した選手を獲得
（${state.selected.length}人）

</button>

</div>

`;

},

school:()=>`

<div class="panel">

<h2>🏫 学校・育成設備</h2>

<p>
施設ポイント：
<b>${state.facilityPoints}</b>
</p>

${facility(
 "training",
 "🏋️ トレーニング施設",
 "練習効果アップ"
)}

${facility(
 "ground",
 "🏟️ グラウンド",
 "疲労軽減"
)}

${facility(
 "medical",
 "🩺 メディカル",
 "コンディション改善"
)}

${facility(
 "scout",
 "🔎 スカウト室",
 "優秀な候補が増える"
)}

${facility(
 "coach",
 "🧠 指導スタッフ",
 "成長効率アップ"
)}

${facility(
 "stadium",
 "🏉 スタジアム",
 "ホーム補正"
)}

</div>

<div class="panel">

<h3>学校情報</h3>

${SCHOOL_DATA.map(
s=>`

<div class="playerLine">

<span>

<b>${s[0]}</b>

<br>

<span class="muted">
${s[1]}
</span>

</span>

<span>
基礎 ${s[2]}
</span>

</div>

`).join("")}

</div>

`,

records:()=>`

<div class="panel">

<h2>🏆 年度ベスト15</h2>

${
state.history.length

?

state.history
.slice()
.reverse()
.map(
h=>`

<div class="card">

<h3>
${h.year}年度
</h3>

<table>

<tr>
<th>#</th>
<th>選手</th>
<th>出身高校</th>
<th>総合</th>
</tr>

${h.best.map(
(p,i)=>`

<tr>

<td>${i+1}</td>

<td>${p.name}</td>

<td>${p.school}</td>

<td>${p.overall}</td>

</tr>

`).join("")}

</table>

</div>

`
).join("")

:

"<p>まだ記録がありません。</p>"

}

</div>

<div class="panel">

<h2>📚 試合記録</h2>

${
state.matches.length

?

state.matches
.slice()
.reverse()
.map(
(m,i)=>`

<div class="playerLine">

<span>

<b>${m.date}</b>

<br>

${m.home}
${m.homeScore}

-

${m.awayScore}
${m.away}

</span>

<button class="action secondary"
onclick="showMatch(${state.matches.length-1-i})">

両チームのメンバー

</button>

</div>

`
).join("")

:

"<p>まだ試合がありません。</p>"

}

</div>

<div class="panel">

<h2>🌟 レジェンドOB</h2>

${
state.legends.length

?

state.legends
.slice()
.reverse()
.map(
l=>`

<div class="card">

<h3>

${l.name}

<span class="tag">
総合 ${l.overall}
</span>

</h3>

<p>

${l.graduatedYear}年度卒業

/

${l.school}

</p>

<p>

進路：
${l.path}

<br>

確約度：
${l.commitment}%

<br>

卒業後：
${l.career}

</p>

</div>

`
).join("")

:

"<p>まだレジェンドOBはいません。高能力選手を育てて卒業させよう。</p>"

}

</div>

`

};

function miniPlayer(p){

 return `

<div
class="playerLine player"
onclick="showPlayer('${p.id}')">

<span>

<b>${p.name}</b>

<span class="tag">
${p.pos}
</span>

<br>

<span class="muted">
${p.year}年 /
${p.school}
</span>

</span>

<b>${p.overall}</b>

</div>

`;

}

function facility(
 k,
 title,
 effect
){

 let lv=state.facilities[k];

 let cost=lv*20;

 return `

<div class="facility">

<span>

<b>
${title} Lv.${lv}
</b>

<br>

<span class="muted">
${effect}
</span>

</span>

<button class="action"
onclick="upgrade('${k}')">

強化 ${cost}pt

</button>

</div>

`;

}

function showPlayer(id){

 let p=[
  ...state.team,
  ...state.scouts
 ]
 .find(
  x=>String(x.id)===String(id)
 );

 if(!p)return;

 document.getElementById(
  "modalBody"
 )
 .innerHTML=
 playerDetail(p);

 document.getElementById(
  "modal"
 )
 .classList.add("open");

}

function playerDetail(p){

 return `

<h2>${p.name}</h2>

<p>

<span class="tag">
${p.pos}
</span>

<span class="tag">
${p.year}年
</span>

<span class="tag">
総合 ${p.overall}
</span>

</p>

<div class="grid">

<div class="stat">
<span>パワー</span>
<b>${p.power}</b>
</div>

<div class="stat">
<span>スピード</span>
<b>${p.speed}</b>
</div>

<div class="stat">
<span>スタミナ</span>
<b>${p.stamina}</b>
</div>

<div class="stat">
<span>パス</span>
<b>${p.pass}</b>
</div>

<div class="stat">
<span>キック</span>
<b>${p.kick}</b>
</div>

<div class="stat">
<span>タックル</span>
<b>${p.tackle}</b>
</div>

<div class="stat">
<span>判断力</span>
<b>${p.decision}</b>
</div>

</div>

<p>

🏫 出身高校：
<b>${p.fromSchool||p.school}</b>

<br>

🎓 卒業後の進路：
${p.path||"未定"}

<br>

🤝 進路確約度：
${p.commitment||0}%

</p>

`;

}

function closeModal(){

 document.getElementById(
  "modal"
 ).classList.remove("open");

}

function train(){

 state.team.forEach(
  p=>{

   if(p.year<4){

    let keys=[
     "power",
     "speed",
     "stamina",
     "pass",
     "kick",
     "tackle",
     "decision"
    ];

    let k=
    keys[rand(0,keys.length-1)];

    p[k]=Math.min(
     99,
     p[k]+
     (Math.random()<.65?1:2)
    );

    p.overall=avg(p);

   }

  }
 );

 state.facilityPoints+=5;

 save();

 render();

 alert(
  "練習完了！\n選手が成長しました。"
 );

}

function nextMonth(){

 state.month++;

 if(state.month>12){

  state.month=1;

  runWorld();

 }

 if(state.month===3){

  graduate();

 }

 save();

 render();

}

function runWorld(){

 let all=[
  ...state.team,
  ...state.scouts.map(
   p=>({...p})
  )
 ];

 all.sort(
  (a,b)=>
   b.overall-a.overall
 );

 state.history.push({

  year:state.year,

  best:
  all.slice(0,15)
  .map(
   p=>({

    name:p.name,
    pos:p.pos,
    overall:p.overall,
    school:
    p.fromSchool||
    p.school

   })
  )

 });

 state.year++;

 state.team.forEach(
  p=>{

   if(p.year<3){

    p.year++;

   }

  }
 );

 state.scouts=
 generateScouts(30);

 state.selected=[];

 state.facilityPoints+=20;

}

function graduate(){

 let leaving=
 state.team.filter(
  p=>p.year>=3
 );

 leaving.forEach(
  p=>{

   let uni=
   UNIVERSITIES[
    rand(0,UNIVERSITIES.length-1)
   ];

   let commitment=
   p.overall>=88
   ?rand(85,100)
   :p.overall>=78
   ?rand(60,90)
   :rand(25,70);

   p.path=uni;

   p.commitment=
   commitment;

   p.graduatedYear=
   state.year;

   state.graduates.push(
    {...p}
   );

   if(p.overall>=85){

    state.legends.push({

     ...p,

     career:
     p.overall>=92
     ?
     "大学→社会人トップリーグ→日本代表候補"
     :
     "大学→社会人トップリーグ"

    });

   }

  }
 );

 state.team=
 state.team.filter(
  p=>p.year<3
 );

}

function toggleScout(id){

 id=String(id);

 let i=
 state.selected
 .map(String)
 .indexOf(id);

 if(i>=0){

  state.selected.splice(i,1);

 }else{

  state.selected.push(id);

 }

 save();

}

function signSelected(){

 let room=
 25-state.team.length;

 if(room<=0){

  alert(
   "部員が25人なので獲得できません。"
  );

  return;

 }

 let ids=
 state.selected
 .slice(0,room);

 let chosen=
 state.scouts.filter(
  p=>
  ids
  .map(String)
  .includes(String(p.id))
 );

 state.team.push(
  ...chosen.map(
   p=>({
    ...p,
    school:state.school
   })
  )
 );

 state.scouts=
 state.scouts.filter(
  p=>
  !ids
  .map(String)
  .includes(String(p.id))
 );

 while(
  state.scouts.length<30
 ){

  state.scouts.push(
   ...generateScouts(1)
  );

 }

 state.selected=[];

 save();

 render();

 alert(
  `${chosen.length}人を獲得しました！`
 );

}

function refreshScouts(){

 state.scouts=
 generateScouts(30);

 state.selected=[];

 save();

 render();

}

function upgrade(k){

 let cost=
 state.facilities[k]*20;

 if(
  state.facilityPoints<cost
 ){

  alert(
   "施設ポイントが足りません。"
  );

  return;

 }

 state.facilityPoints-=cost;

 state.facilities[k]++;

 save();

 render();

}

function openMatchSelect(){

 if(state.team.length<15){

  alert(
   "試合には15人以上必要です。"
  );

  return;

 }

 let opp=
 SCHOOL_DATA
 .filter(
  x=>x[0]!==state.school
 )
 .sort(
  ()=>Math.random()-.5
 )[0];

 let opponent=
 makeTeam(opp[0]);

 state.match={
  opponent:opp[0],
  players:opponent
 };

 showMatchSetup();

}

function showMatchSetup(){

 document.getElementById(
  "modalBody"
 ).innerHTML=

 `<h2>🏉 練習試合</h2>

 <p>
 対戦校：
 <b>${state.match.opponent}</b>
 </p>

 <p>
 先発15人を選択してください。
 </p>

 <div class="players">

 ${state.team.map(
  p=>`

  <label class="playerLine">

  <span>

  <input
   type="checkbox"
   class="starter"
   value="${p.id}">

  <b>${p.name}</b>

  ${p.pos}

  </span>

  <b>${p.overall}</b>

  </label>

 `
 ).join("")}

 </div>

 <button
 class="action"
 onclick="playMatch()">

 試合開始

 </button>`;

 document.getElementById(
  "modal"
 )
 .classList.add("open");

}

function playMatch(){

 let ids=
 [...document.querySelectorAll(
  ".starter:checked"
 )]
 .map(
  x=>String(x.value)
 );

 if(ids.length!==15){

  alert(
   "先発15人を選んでください。"
  );

  return;

 }

 let home=
 state.team.filter(
  p=>ids.includes(
   String(p.id)
  )
 );

 let away=
 state.match.players
 .slice(0,15);

 let h=
 50+
 Math.round(
  home.reduce(
   (s,p)=>s+p.overall,
   0
  )/15
 )+
 state.facilities.stadium*2+
 rand(-25,25);

 let a=
 50+
 Math.round(
  away.reduce(
   (s,p)=>s+p.overall,
   0
  )/15
 )+
 rand(-25,25);

 let hs=
 Math.max(
  0,
  Math.floor((h-65)/5)+
  rand(0,4)
 );

 let as=
 Math.max(
  0,
  Math.floor((a-65)/5)+
  rand(0,4)
 );

 state.matches.push({

  date:
  `${state.year}/${state.month}`,

  home:state.school,

  away:
  state.match.opponent,

  homeScore:hs,

  awayScore:as,

  homePlayers:
  home.map(
   x=>({...x})
  ),

  awayPlayers:
  away.map(
   x=>({...x})
  )

 });

 state.facilityPoints+=
 hs>as?10:5;

 closeModal();

 save();

 render();

 alert(
  `${state.school} ${hs} - ${as} ${state.match.opponent}`
 );

}

function showMatch(i){

 let m=
 state.matches[i];

 if(!m)return;

 document.getElementById(
  "modalBody"
 ).innerHTML=

 `<h2>
 ${m.home}
 ${m.homeScore}
 -
 ${m.awayScore}
 ${m.away}
 </h2>

 <div class="grid">

 <div>

 <h3>${m.home}</h3>

 ${m.homePlayers.map(
  (p,i)=>
  `<div class="playerLine">
   <span>
   ${i+1}.
   ${p.name}
   ${p.pos}
   </span>
   <b>${p.overall}</b>
  </div>`
 ).join("")}

 </div>

 <div>

 <h3>${m.away}</h3>

 ${m.awayPlayers.map(
  (p,i)=>
  `<div class="playerLine">
   <span>
   ${i+1}.
   ${p.name}
   ${p.pos}
   </span>
   <b>${p.overall}</b>
  </div>`
 ).join("")}

 </div>

 </div>`;

 document.getElementById(
  "modal"
 )
 .classList.add("open");

}

render();

</script>

</body>
</html>
