function playMatch(opponent,strength,tournament,practice){
 const us=teamOverall();
 const variance=rand(-10,10);

 let usScore=clamp(Math.round((us-strength)*1.1+35+variance),0,100);
 let themScore=clamp(Math.round((strength-us)*1.0+28+rand(-8,8)),0,100);

 /*
  試合として自然になるように多少調整
 */
 if(us>strength)usScore+=rand(3,15);
 if(us<strength)themScore+=rand(3,15);

 usScore=clamp(usScore,0,99);
 themScore=clamp(themScore,0,99);

 const win=usScore>themScore;

 const starters=getStarters();

 starters.forEach(x=>{
  x.player.appearances++;
  if(win && Math.random()<.3)x.player.tries++;
  if(Math.random()<.4)x.player.tacklesMade+=rand(1,5);
 });

 const match={
  date:`${game.year}/${game.month}`,
  tournament,
  opponent,
  scoreUs:usScore,
  scoreThem:themScore,
  win,
  roster:starters.map(x=>({
   number:x.number,
   position:x.position,
   playerId:x.player.id,
   playerName:x.player.name,
   effectiveOverall:x.effectiveOverall
  })),
  opponentRoster:makeOpponent15(opponent,strength).map((p,i)=>({
   number:i+1,
   position:POSITIONS[i].name,
   name:p.name,
   nationality:p.nationality,
   overall:p.overall
  }))
 };

 game.history.push(match);

 return {
  win,
  scoreUs:usScore,
  scoreThem:themScore
 };
}

function practiceMatch(){
 const schools=(SCHOOL_DATA[game.prefecture]||[])
  .filter(s=>s[0]!==game.school);

 if(!schools.length)return;

 const opponent=pick(schools);

 if(Object.keys(game.lineup).length<15){
  alert("先にスタメン15人を決定してください。");
  renderLineup();
  return;
 }

 showMatchPreview(
  opponent[0],
  opponent[1],
  "練習試合",
  ()=>{
   const r=playMatch(opponent[0],opponent[1],"練習試合",true);
   alert(`${r.win?"勝利":"敗北"}！\n${r.scoreUs}-${r.scoreThem}`);
   autoSave();
   renderGame();
  }
 );
}

