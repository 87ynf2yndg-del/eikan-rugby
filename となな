/* =========================================================
   ユーティリティ
   ========================================================= */

function rand(min,max){
 return Math.floor(Math.random()*(max-min+1))+min;
}

function pick(arr){
 return arr[Math.floor(Math.random()*arr.length)];
}

function clamp(v,min,max){
 return Math.max(min,Math.min(max,v));
}

function avg(arr){
 if(!arr.length)return 0;
 return Math.round(arr.reduce((a,b)=>a+b,0)/arr.length);
}

function esc(str){
 return String(str)
  .replaceAll("&","&amp;")
  .replaceAll("<","&lt;")
  .replaceAll(">","&gt;")
  .replaceAll('"',"&quot;");
}

function saveKey(slot){
 return "eikan_rugby_save_"+slot;
}

function saveGame(slot){
 if(!game)return;
 localStorage.setItem(saveKey(slot),JSON.stringify(game));
 game.lastSaved = new Date().toLocaleString("ja-JP");
 localStorage.setItem(saveKey(slot),JSON.stringify(game));
}

function loadGame(slot){
 const raw=localStorage.getItem(saveKey(slot));
 if(!raw)return false;
 try{
  game=JSON.parse(raw);
  return true;
 }catch(e){
  return false;
 }
}

function deleteSave(slot){
 localStorage.removeItem(saveKey(slot));
 renderTitle();
}

function randomName(){
 return pick(JAPAN_FIRST)+" "+pick(JAPAN_LAST);
}

function foreignName(country){
 return pick(FOREIGN_NAMES[country]);
}

function nationalityBadge(p){
 const flag=FLAGS[p.nationality]||"🏳️";
 const cls=p.nationality==="日本"?"japan":"foreign";
 return `<span class="badge ${cls}">${flag} ${esc(p.nationality)}</span>`;
}

function geniusBadge(p){
 return p.genius?`<span class="badge genius">⭐ 天才</span>`:"";
}

function worldBadge(p){
 return p.worldSelected?`<span class="badge world">🌎 世界選抜</span>`:"";
}

/* =========================================================
   選手生成
   ========================================================= */

function makePlayer(pref,school,strength,grade=1,forceForeign=false){
 const foreign = forceForeign || Math.random()<0.035;
 let nationality="日本";
 let name=randomName();

 if(foreign){
  nationality=pick(Object.keys(FOREIGN_NAMES));
  name=foreignName(nationality);
 }

 /*
  天才は約4%。
  スカウト抽選時に通常の2倍扱い。
 */
 const genius=Math.random()<0.04;

 const position=pick(POSITION_NAMES);

 let base=strength+rand(-13,13)+rand(-grade*2,grade*3);
 if(genius)base+=rand(7,13);
 if(foreign)base+=rand(2,9);

 base=clamp(base,35,99);

 const stats={
  speed:clamp(base+rand(-12,10),25,99),
  power:clamp(base+rand(-10,12),25,99),
  stamina:clamp(base+rand(-8,10),25,99),
  skill:clamp(base+rand(-10,10),25,99),
  kick:clamp(base+rand(-12,10),20,99),
  tackle:clamp(base+rand(-9,11),25,99),
  lineout:clamp(base+rand(-10,10),20,99),
  scrum:clamp(base+rand(-10,11),20,99)
 };

 let overall=Math.round(Object.values(stats).reduce((a,b)=>a+b,0)/Object.values(stats).length);

 return {
  id:"P"+Date.now()+"_"+Math.random().toString(36).slice(2),
  name,
  nationality,
  grade,
  position,
  overall:clamp(overall,25,99),
  stats,
  genius,
  foreign,
  sourceSchool:school,
  sourcePref:pref,
  destination:null,
  commitment:0,
  worldSelected:false,
  worldYear:null,
  tries:0,
  appearances:0,
  tacklesMade:0
 };
}

function makeTeam(pref,school,strength,count=23){
 const arr=[];
 for(let i=0;i<count;i++){
  let grade=i<8?3:i<16?2:1;
  arr.push(makePlayer(pref,school,strength,grade));
 }
 return arr;
}

