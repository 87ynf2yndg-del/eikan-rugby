function calculateBest15(){
 return game.roster
  .slice()
  .sort((a,b)=>{
   const scoreA=a.overall+a.tries*2+a.tacklesMade;
   const scoreB=b.overall+b.tries*2+b.tacklesMade;
   return scoreB-scoreA;
  })
  .slice(0,15);
}

function saveBest15(){
 const best=calculateBest15();

 game.best15History.push({
  year:game.year,
  players:best.map(p=>({
   name:p.name,
   position:p.position,
   overall:p.overall,
   sourceSchool:p.sourceSchool
  }))
 });

 game.logs.push(`${game.year}年度ベスト15を記録しました。`);
 autoSave();
 alert("年間ベスト15を記録しました！");
}

function graduateHTML(p){
 return `
 <div class="player">
  <b>${esc(p.name)}</b>
  ${nationalityBadge(p)}
  ${geniusBadge(p)}
  <div class="stat"><span>総合</span><b>${p.overall}</b></div>
  <div class="stat"><span>出身高校</span><b>${esc(p.sourceSchool)}</b></div>
  <div class="stat"><span>進学先</span><b>${esc(p.destination||"未定")}</b></div>
  <div class="stat"><span>確約度</span><b>${p.commitment}%</b></div>
 </div>
 `;
}

/* =========================================================
   学校検索
   ========================================================= */

function findSchoolPref(school){
 for(const pref of PREFS){
  const list=SCHOOL_DATA[pref]||[];
  if(list.some(s=>s[0]===school))return pref;
 }
 return game.prefecture;
}

