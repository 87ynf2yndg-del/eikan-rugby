   </div>

   <div class="stat">
    <span>選択人数</span>
    <b>${game.selectedCandidates.length}人</b>
   </div>

   ${game.candidates.map((p,i)=>`
    <div class="player">
     <div class="player-title">
      <div>
       <b>${esc(p.name)}</b><br>
       ${nationalityBadge(p)}
       <span class="badge">${p.grade}年</span>
       <span class="badge pos">${p.position}</span>
       ${geniusBadge(p)}
      </div>
      <div class="ovr">${p.overall}</div>
     </div>

     <div class="muted" style="margin:6px 0">
      ${esc(p.sourceSchool)}
     </div>

     <button class="${game.selectedCandidates.includes(p.id)?"warning":"primary"} small"
      onclick="toggleCandidate('${p.id}')">
      ${game.selectedCandidates.includes(p.id)?"選択解除":"獲得候補に追加"}
     </button>

     <button class="secondary small" onclick="showCandidate('${p.id}')">
      詳細
     </button>
    </div>
   `).join("")}

   <button class="primary big" onclick="acquireCandidates()">選択選手を獲得</button>
   <button class="secondary big" onclick="generateScouting();renderScouting()">候補を入れ替える</button>
