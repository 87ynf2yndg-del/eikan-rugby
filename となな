}

function toggleCandidate(id){
 if(game.selectedCandidates.includes(id)){
  game.selectedCandidates=game.selectedCandidates.filter(x=>x!==id);
 }else{
  game.selectedCandidates.push(id);
 }
 renderScouting();
}

function showCandidate(id){
 const p=game.candidates.find(x=>x.id===id);
 if(!p)return;

 alert(
  `${p.name}\n`+
  `${FLAGS[p.nationality]} ${p.nationality}\n`+
  `学年：${p.grade}年\n`+
  `ポジション：${p.position}\n`+
  `総合：${p.overall}\n`+
  `出身：${p.sourceSchool}\n`+
  `${p.genius?"⭐ 天才選手\n":""}`
 );
}

function acquireCandidates(){
 const free=50-game.roster.length;

 if(game.selectedCandidates.length>free){
  alert(`部員枠が足りません。\n獲得可能人数：${free}人`);
  return;
 }

 if(!game.selectedCandidates.length){
  alert("選手を選択してください。");
  return;
 }

 for(const id of game.selectedCandidates){
  const p=game.candidates.find(x=>x.id===id);
  if(p){
   game.roster.push(p);
   game.logs.push(`スカウトで${p.name}を獲得。`);
  }
 }

 const count=game.selectedCandidates.length;
 game.candidates=[];
 game.selectedCandidates=[];
 autoSave();

 alert(`${count}人を獲得しました！`);
 renderGame();
}

