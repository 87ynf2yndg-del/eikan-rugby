/* =========================================================
   スタメン
   ========================================================= */

function getStarters(){
 return POSITIONS.map(pos=>{
  const p=game.roster.find(x=>game.lineup[pos.no]===x.id);
  if(!p)return null;

  const fit=positionFit(p,pos.name);
  return {
   number:pos.no,
   position:pos.name,
   player:p,
   fit,
   effectiveOverall:fit?p.overall:p.overall-5
  };
 }).filter(Boolean);
}

function positionFit(p,pos){
 if(pos==="No.8")return ["No.8","FL"].includes(p.position);
 if(pos==="CTB")return ["CTB","WTB"].includes(p.position);
 return p.position===pos;
}

function renderLineup(){
 document.getElementById("app").innerHTML=
 headerHTML()+
 `<main class="container">
  <div class="card">
   <button class="secondary small" onclick="renderGame()">← 戻る</button>
   <h1>🏉 スタメン決定</h1>

   <div class="notice">
    <b>背番号順に決定します。</b><br>
    適性外のポジションで出場すると、その試合のみ総合値が<strong>−5</strong>されます。
   </div>

   ${POSITIONS.map(pos=>lineupPosition(pos)).join("")}

   <button class="primary big" onclick="finishLineup()">スタメンを確定</button>
  </div>
 </main>`;
}

function lineupPosition(pos){
 const current=game.lineup[pos.no];
 const p=current?game.roster.find(x=>x.id===current):null;

 const candidates=game.roster
  .filter(x=>x.grade>=1)
  .sort((a,b)=>{
   const af=positionFit(a,pos.name);
   const bf=positionFit(b,pos.name);
   if(af!==bf)return bf-af;
   return b.overall-a.overall;
  });

 return `
 <div class="card">
  <h3>背番号 ${pos.no}：${pos.name}</h3>

  ${p?`
   <div class="notice">
    現在：<b>${esc(p.name)}</b>
    ${positionFit(p,pos.name)?
     " 🟢 適性あり":
     " 🔴 適性外（試合総合 −5）"}
   </div>
  `:"<div class=\"muted\">まだ選択されていません</div>"}

  ${candidates.map(x=>`
   <button class="pos-btn ${current===x.id?"selected":""}"
    onclick="setLineup(${pos.no},'${x.id}')">
    <b>${esc(x.name)}</b>
    <span style="float:right">${x.overall}</span><br>
    ${nationalityBadge(x)}
    <span class="badge pos">本来 ${x.position}</span>
    ${positionFit(x,pos.name)?
     '<span class="badge">適性◎</span>':
     '<span class="badge">適性外 −5</span>'}
   </button>
  `).join("")}
 </div>
 `;
}

function setLineup(number,id){
 /* 同一選手の重複を防ぐ */
 for(const n in game.lineup){
  if(game.lineup[n]===id && Number(n)!==number){
   delete game.lineup[n];
  }
 }
 game.lineup[number]=id;
 renderLineup();
}

function finishLineup(){
 if(Object.keys(game.lineup).length<15){
  alert("15人すべての背番号を決定してください。");
  return;
 }
 game.logs.push("スタメン15人を確定しました。");
 autoSave();
 alert("スタメンを確定しました！");
 renderGame();
}

