   ${facilityCard("scouting","🔎 スカウト網","スカウト候補の質")}
   ${facilityCard("medical","🏥 メディカル","コンディション")}
  </div>
 </main>`;
}

function facilityCard(key,title,desc){
 const lv=game.facilities[key];

 return `
 <div class="card">
  <h3>${title}</h3>
  <p class="muted">${desc}</p>
  <div class="stat">
   <span>Lv.</span><b>${lv}</b>
  </div>
  <button class="primary small" onclick="upgradeFacility('${key}')">
   強化（${lv*30}）
  </button>
 </div>
 `;
}

function upgradeFacility(key){
 const cost=game.facilities[key]*30;

 if(game.money<cost){
  alert("資金が足りません。");
  return;
 }

 game.money-=cost;
 game.facilities[key]++;
 game.logs.push(`${key}施設をLv.${game.facilities[key]}へ強化。`);

 autoSave();
 renderFacilities();
}

