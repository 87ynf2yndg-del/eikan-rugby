/* =========================================================
   地区予選
   ========================================================= */

function startPrefTournament(){
 if(game.month!==10){
  alert("地区予選は10月です。");
  return;
 }

 if(Object.keys(game.lineup).length<15){
  alert("先に15人のスタメンを決めてください。");
  renderLineup();
  return;
 }

 const schools=(SCHOOL_DATA[game.prefecture]||[])
  .filter(x=>x[0]!==game.school)
  .sort((a,b)=>b[1]-a[1]);

 const opponents=schools.slice(0,Math.min(7,schools.length));

 runTournamentRounds(opponents,"地区予選",false);
}

function runTournamentRounds(opponents,tournament,isNational){
 if(!opponents.length){
  game.nationalQualified=true;
  alert("対戦校がいないため予選突破扱いです。");
  autoSave();
  renderGame();
  return;
 }

 let round=1;
 let currentOpponents=opponents;

 function nextRound(){
  if(round>currentOpponents.length){
   if(!isNational){
    game.nationalQualified=true;
    game.octoberDone=true;
    game.logs.push(`${game.prefecture}地区予選を優勝！全国大会出場権獲得。`);
    autoSave();
    alert("🏆 地区予選優勝！\n全国大会出場決定！");
    renderGame();
   }else{
    game.nationalDone=true;
    game.logs.push("全国大会を戦い終えました。");
    autoSave();
    renderGame();
   }
   return;
  }

  const opponent=currentOpponents[round-1];
  showMatchPreview(
   opponent[0],
   opponent[1],
   tournament+" 第"+round+"戦",
   ()=>{
    const result=playMatch(
     opponent[0],
     opponent[1],
     tournament,
     false
    );

    if(!result.win){
     alert(`敗退しました。\n${result.scoreUs}-${result.scoreThem}`);
     autoSave();
     renderGame();
     return;
    }

    alert(`勝利！\n${result.scoreUs}-${result.scoreThem}`);
    round++;
    nextRound();
   }
  );
 }

 nextRound();
}

/* =========================================================
   全国大会
   ========================================================= */

function startNationalTournament(){
 if(!game.nationalQualified){
  alert("まず都道府県予選を勝ち抜いてください。");
  return;
 }

 const all=[];

 for(const pref of PREFS){
  for(const s of (SCHOOL_DATA[pref]||[])){
   if(s[0]!==game.school){
    all.push({
     school:s[0],
     pref,
     strength:s[1]
    });
   }
  }
 }

 all.sort((a,b)=>b.strength-a.strength);

 /*
  実際の全国大会は56チーム規模。
  ゲームでは操作性を考慮し16校トーナメント。
 */
 const opponents=all.slice(0,7).map(x=>[x.school,x.strength]);

 runTournamentRounds(opponents,"全国大会",true);
}

