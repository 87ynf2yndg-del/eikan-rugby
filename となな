<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>栄冠ラグビー</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  background:#07111f;
  color:#f5f7fa;
  font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif;
}
button,select,input{
  font:inherit;
}
button{
  border:0;
  border-radius:10px;
  padding:12px 15px;
  font-weight:bold;
  cursor:pointer;
}
button:active{transform:scale(.97)}
.container{
  max-width:1100px;
  margin:auto;
  padding:14px;
}
header{
  position:sticky;
  top:0;
  z-index:50;
  background:#0b1729;
  border-bottom:1px solid #263752;
  padding:10px 12px;
}
.header-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}
.logo{
  font-size:20px;
  font-weight:900;
}
.header-info{
  font-size:12px;
  color:#b7c4d8;
}
h1,h2,h3{margin:8px 0 14px}
.card{
  background:#0d1b30;
  border:1px solid #263752;
  border-radius:14px;
  padding:15px;
  margin-bottom:13px;
}
.hero{
  text-align:center;
  padding:30px 16px;
}
.title{
  font-size:42px;
  font-weight:1000;
  letter-spacing:2px;
  margin:15px 0;
}
.subtitle{color:#9eabc0}
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  gap:10px;
}
.grid2{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
}
.grid3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}
.pref{
  background:#14253d;
  color:white;
  border:1px solid #304763;
  min-height:55px;
}
.pref.selected{
  background:#0d6b45;
  border-color:#27d48c;
}
.primary{
  background:#16a36b;
  color:white;
}
.secondary{
  background:#253852;
  color:white;
}
.warning{
  background:#c78317;
  color:white;
}
.danger{
  background:#a92d3e;
  color:white;
}
.dark{
  background:#101c2e;
  color:white;
  border:1px solid #33445d;
}
.big{
  width:100%;
  font-size:18px;
  padding:15px;
}
.small{
  font-size:12px;
  padding:7px 9px;
}
.stat{
  display:flex;
  justify-content:space-between;
  padding:8px 0;
  border-bottom:1px solid #23344e;
}
.stat:last-child{border-bottom:0}
.player{
  background:#12243b;
  border:1px solid #2d425f;
  border-radius:12px;
  padding:11px;
  margin-bottom:8px;
}
.player-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
}
.ovr{
  font-size:22px;
  font-weight:900;
}
.badge{
  display:inline-block;
  border-radius:999px;
  padding:4px 8px;
  font-size:11px;
  margin:2px;
  background:#273c58;
}
.badge.japan{background:#263c72}
.badge.foreign{background:#713b59}
.badge.genius{background:#7b5a16}
.badge.world{background:#7b321e}
.badge.pos{background:#145b53}
.pos-btn{
  width:100%;
  text-align:left;
  background:#13263e;
  color:white;
  border:1px solid #304763;
  margin-bottom:7px;
}
.pos-btn.selected{
  background:#116346;
  border-color:#26d38c;
}
.bar{
  height:9px;
  background:#26364d;
  border-radius:8px;
  overflow:hidden;
  margin-top:4px;
}
.bar span{
  display:block;
  height:100%;
  background:#2ed18b;
}
.notice{
  padding:11px;
  background:#122c2b;
  border:1px solid #1c6359;
  border-radius:10px;
  margin-bottom:10px;
}
.month{
  font-size:24px;
  font-weight:900;
}
.match{
  padding:13px;
  background:#102138;
  border:1px solid #2c405c;
  border-radius:12px;
  margin-bottom:10px;
}
.score{
  font-size:28px;
  font-weight:1000;
  text-align:center;
  margin:8px;
}
.center{text-align:center}
.muted{color:#9dacbf}
.hidden{display:none!important}
.save-slot{
  border:1px solid #304763;
  padding:15px;
  border-radius:12px;
  background:#12243a;
  margin-bottom:10px;
}
.table{
  width:100%;
  border-collapse:collapse;
}
.table th,.table td{
  padding:8px;
  border-bottom:1px solid #293b55;
  text-align:left;
  font-size:13px;
}
@media(max-width:600px){
  .title{font-size:34px}
  .grid3{grid-template-columns:1fr 1fr}
  .grid2{grid-template-columns:1fr}
}
