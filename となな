function saveSlotHTML(slot,raw){
 if(!raw){
  return `
   <div class="save-slot">
    <b>セーブ${slot}</b>
    <div class="muted">空きスロット</div>
   </div>
  `;
 }

 let d;
 try{d=JSON.parse(raw)}catch(e){d=null}

 if(!d){
  return `<div class="save-slot">セーブ${slot}：読み込みエラー</div>`;
 }

 return `
 <div class="save-slot">
  <div style="display:flex;justify-content:space-between;gap:8px">
   <div>
    <b>セーブ${slot}</b>
    <div>${esc(d.school)}（${esc(d.prefecture)}）</div>
