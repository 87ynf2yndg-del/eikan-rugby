   スカウト
   ========================================================= */

function generateScouting(){
 const schools=SCHOOL_DATA[game.prefecture]||[];
 game.candidates=[];

 for(let i=0;i<30;i++){
  const s=pick(schools);
  const strength=s[1];

  /*
   天才出現率2倍。
   通常4%に対し、スカウトでは8%。
  */
  const genius=Math.random()<0.08;
  const p=makePlayer(game.prefecture,s[0],strength,rand(1,3),Math.random()<0.07);

  if(genius){
   p.genius=true;
   p.overall=clamp(p.overall+rand(5,12),1,99);
   for(const k in p.stats){
    p.stats[k]=clamp(p.stats[k]+rand(3,9),1,99);
   }
  }

  game.candidates.push(p);
 }

 game.selectedCandidates=[];
}

function renderScouting(){
 if(!game.candidates.length)generateScouting();

 document.getElementById("app").innerHTML=
 headerHTML()+
 `<main class="container">
  <div class="card">
   <button class="secondary small" onclick="renderGame()">← 戻る</button>
   <h1>🔎 スカウト</h1>

   <div class="notice">
    候補は30人。複数人選択できます。<br>
