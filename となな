   </div>
   <div>
    <button class="primary small" onclick="continueSave(${slot})">ロード</button>
    <button class="danger small" onclick="deleteSave(${slot})">削除</button>
   </div>
  </div>
 </div>
 `;
}

function continueSave(slot){
 if(loadGame(slot)){
  selectedSave=slot;
  renderGame();
 }else{
  alert("セーブデータを読み込めませんでした。");
 }
}

